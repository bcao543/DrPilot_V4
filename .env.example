# 复制为 .env 后填入自己的 Key（.env 已被 .gitignore 忽略，不会提交）
#
# 方式一：按顺序编号，一个 Key 一个 worker
SILICONFLOW_API_KEY_1=sk-在这里填入第一个Key
SILICONFLOW_API_KEY_2=sk-在这里填入第二个Key

# 方式二：逗号分隔
# SILICONFLOW_API_KEYS=sk-aaa,sk-bbb

# 可选：覆盖模型与 API 地址
# DRPILOT_MODEL=Qwen/Qwen3.5-4B
# DRPILOT_BASE_URL=https://api.siliconflow.cn/v1

# 可选：adb 可执行文件路径（也可用命令行 --adb 指定）
# ADB=C:/platform-tools/adb.exe
